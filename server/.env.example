# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000

# Must match AMI_ESCALATION_SHARED_SECRET in the Android app's local.properties.
# Generate a random value, e.g.: openssl rand -hex 32
SHARED_SECRET=

# The public HTTPS origin this server is reachable at, with no trailing slash,
# e.g. https://ami-escalation.onrender.com
#
# Required for call-outcome reporting: it is both the statusCallback URL handed to
# Twilio and the URL the webhook signature is validated against. Leave blank for
# local-only testing - calls still go out, but the app reports the outcome as unknown
# rather than "answered" or "nobody picked up".
PUBLIC_BASE_URL=

# SMTP credentials used to actually send the caregiver email.
# Any SMTP provider works (Gmail app password, SendGrid, Mailgun, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Twilio, used for the real-phone-call rung of the escalation ladder.
# Leave blank to disable calling; /api/call then returns 503 and the app falls
# straight through to emailing the caregiver.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Must be a number you have purchased in Twilio, in E.164 format e.g. +14155550123
TWILIO_FROM_NUMBER=

<?xml version="1.0" encoding="utf-8"?>
<!--
  One complaint in the "what I've noticed" list: the symptom and how often it came up,
  with the person's own words underneath so a caregiver can see where it came from.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/space_md"
    android:orientation="vertical">

    <TextView
        android:id="@+id/symptomHeadline"
        style="@style/AmiText.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/symptomDetail"
        style="@style/AmiText.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:visibility="gone" />
</LinearLayout>

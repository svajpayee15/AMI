<?xml version="1.0" encoding="utf-8"?>
<!--
  One line of history: what happened, when, and how it ended. Used for both the
  medicine check-in list and the guided-navigation log, which have the same shape.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="@drawable/bg_medicine_row"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_md"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_md">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/historyTitle"
            style="@style/AmiText.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/historyWhen"
            style="@style/AmiText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/historyNote"
            style="@style/AmiText.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/historyOutcome"
        style="@style/AmiPill"
        android:layout_marginStart="@dimen/space_sm"
        android:background="@drawable/bg_pill_success"
        android:textColor="@color/ami_on_success_container" />

</LinearLayout>

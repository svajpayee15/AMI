<?xml version="1.0" encoding="utf-8"?>
<!--
  The caregiver's screen. Everything here answers one of two questions: is the medicine
  being taken, and what has the assistant been doing on this phone. Both were previously
  invisible from inside the app - the check-in history existed only in the database and
  the navigation steps were not recorded at all.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <!--
          No Back button any more: this is a top-level destination with its own tab in
          the bottom bar, and Material is right that an up arrow on one of those only
          raises the question of up to where.
        -->
        <TextView
            style="@style/AmiText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/report_title" />

        <!-- Adherence -->
        <LinearLayout
            style="@style/AmiCard"
            android:layout_marginTop="@dimen/space_lg">

            <TextView
                style="@style/AmiText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_adherence_title" />

            <TextView
                android:id="@+id/reportHeadline"
                style="@style/AmiText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/report_no_data" />

            <LinearLayout
                android:id="@+id/reportBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/reportThirtyDay"
                style="@style/AmiText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" />
        </LinearLayout>

        <!-- Check-ins -->
        <LinearLayout
            style="@style/AmiCard"
            android:layout_marginTop="@dimen/space_md">

            <TextView
                style="@style/AmiText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_checkins_title" />

            <TextView
                android:id="@+id/checkInsEmpty"
                style="@style/AmiText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/report_checkins_empty" />

            <LinearLayout
                android:id="@+id/checkInsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Guided-navigation log -->
        <LinearLayout
            style="@style/AmiCard"
            android:layout_marginTop="@dimen/space_md">

            <TextView
                style="@style/AmiText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/report_actions_title" />

            <TextView
                style="@style/AmiText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/report_actions_body" />

            <TextView
                android:id="@+id/actionsEmpty"
                style="@style/AmiText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/report_actions_empty" />

            <LinearLayout
                android:id="@+id/actionsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearActions"
                style="@style/AmiButton.Secondary"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md"
                android:text="@string/report_actions_clear"
                app:icon="@drawable/ic_trash" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

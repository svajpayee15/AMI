<?xml version="1.0" encoding="utf-8"?>
<!--
  "Sync your health" bottom sheet, from the Figma "Profile - Connect Smartwear" frame.

  The design's Apple Watch photograph is replaced by a generic wearable drawing: the
  target store here is Health Connect, which any band or watch can write into, so
  picturing one manufacturer's device would misrepresent what the button does.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_gutter"
    android:paddingEnd="@dimen/screen_gutter"
    android:paddingTop="@dimen/space_md"
    android:paddingBottom="@dimen/space_xl">

    <ImageView
        android:id="@+id/btnCloseSheet"
        android:layout_width="@dimen/touch_target_small"
        android:layout_height="@dimen/touch_target_small"
        android:layout_gravity="end"
        android:padding="@dimen/space_md"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/connect_sheet_close" />

    <ImageView
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/space_sm"
        android:src="@drawable/ic_wearable"
        android:importantForAccessibility="no"
        android:contentDescription="@null" />

    <TextView
        style="@style/AmiText.Display"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_lg"
        android:gravity="center_horizontal"
        android:text="@string/connect_sheet_title" />

    <TextView
        android:id="@+id/sheetBody"
        style="@style/AmiText.Body.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_sm"
        android:gravity="center_horizontal"
        android:text="@string/connect_sheet_body" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        style="@style/AmiButton"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xl"
        android:text="@string/connect_sheet_action" />

</LinearLayout>

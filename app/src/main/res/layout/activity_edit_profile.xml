<?xml version="1.0" encoding="utf-8"?>
<!--
  Edit profile. Two optional fields, both local.

  The date of birth is a button plus a read-back label rather than a typed field: this
  app's users should never have to get a date format right, and a picker cannot produce
  an invalid one.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xxl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/AmiButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_back"
            app:icon="@drawable/ic_chevron_left" />

        <TextView
            style="@style/AmiText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/profile_edit_title" />

        <LinearLayout
            style="@style/AmiCard"
            android:layout_marginTop="@dimen/space_lg">

            <TextView
                style="@style/AmiText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/profile_name_label" />

            <EditText
                android:id="@+id/profileName"
                style="@style/AmiInput"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:hint="@string/profile_name_hint"
                android:inputType="textPersonName|textCapWords"
                android:autofillHints="name"
                android:imeOptions="actionDone" />

            <TextView
                style="@style/AmiText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/profile_dob_label" />

            <TextView
                android:id="@+id/profileDobValue"
                style="@style/AmiText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChooseDob"
                style="@style/AmiButton.Secondary"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/profile_dob_choose"
                app:icon="@drawable/ic_clock" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearDob"
                style="@style/AmiButton.Secondary"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/profile_dob_clear"
                android:visibility="gone"
                app:icon="@drawable/ic_trash" />
        </LinearLayout>

        <TextView
            style="@style/AmiText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_md"
            android:text="@string/profile_stored_locally" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/AmiButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/profile_save"
            app:icon="@drawable/ic_check_circle" />

    </LinearLayout>
</ScrollView>

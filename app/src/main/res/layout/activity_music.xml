<?xml version="1.0" encoding="utf-8"?>
<!--
  Music therapy. Scene behind, chrome over it, and two pieces on top that no other scene
  has: the mood chips under the headline, and the player card along the bottom.

  The hint row is left where the include puts it and the player card sits below it, which
  is the reference's stacking.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/game_room_top">

    <com.example.ami.games.MusicSceneView
        android:id="@+id/musicScene"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <include layout="@layout/include_game_chrome" />

    <!-- Mood chips. Wrapped so a long label drops to the next line instead of clipping. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/screen_gutter"
        android:layout_marginTop="150dp"
        android:layout_marginEnd="@dimen/screen_gutter"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/musicChipRows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!--
          The design's "ADD MUSIC +". This is what makes the screen work at all: no audio
          came with the hand-off, so the music is whatever is already on the phone.
        -->
        <TextView
            android:id="@+id/btnMusicAdd"
            style="@style/AmiGameCardText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:background="@drawable/bg_game_chip"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:minHeight="@dimen/touch_target"
            android:paddingStart="@dimen/space_md"
            android:paddingEnd="@dimen/space_md"
            android:text="@string/game_music_add" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="@dimen/space_md"
        android:layout_marginEnd="@dimen/space_md"
        android:layout_marginBottom="@dimen/space_md"
        android:orientation="vertical">

        <!--
          The scene chrome's hint row sits at the very bottom, which this card would cover,
          so music carries its own copy just above the card and hides the shared one.
        -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginBottom="@dimen/space_md"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_game_swipe" />

            <TextView
                style="@style/AmiGameHint"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_md"
                android:layout_weight="1"
                android:text="@string/game_music_hint" />
        </LinearLayout>

        <LinearLayout style="@style/AmiGameCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/musicTitle"
                    style="@style/AmiGameCardText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1" />

                <TextView
                    android:id="@+id/musicTime"
                    style="@style/AmiGameCardText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_md" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/musicProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="@dimen/space_md"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/game_accent"
                android:progressBackgroundTint="#33000000" />

            <TextView
                android:id="@+id/musicEmptyNote"
                style="@style/AmiText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_sm"
                android:text="@string/game_music_empty_hint"
                android:textColor="@color/game_ink_soft" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="@dimen/space_md"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/btnMusicPrev"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_music_prev"
                    android:padding="14dp"
                    android:src="@drawable/ic_chevron_left"
                    app:tint="@color/game_ink"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />

                <ImageButton
                    android:id="@+id/btnMusicPlay"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:layout_marginStart="@dimen/space_lg"
                    android:layout_marginEnd="@dimen/space_lg"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_music_play"
                    android:padding="16dp"
                    android:src="@drawable/ic_game_play" />

                <ImageButton
                    android:id="@+id/btnMusicNext"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/game_music_next"
                    android:padding="14dp"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="@color/game_ink"
                    xmlns:app="http://schemas.android.com/apk/res-auto" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>

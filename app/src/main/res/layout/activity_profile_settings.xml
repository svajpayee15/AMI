<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, from the Figma "Profile - Settings" frame.

  Two departures from the design, both deliberate and both noted where they occur:

  1. The source is an iOS design. "Apple Health" becomes Health Connect, which is the
     Android equivalent and what this app already reads vitals through. There is no
     HealthKit on Android to connect to.
  2. There is no account system, so "Log out" is not here. A dead control in a care app
     is worse than an absent one. "Delete account" becomes "Delete all my data", which
     is a real operation: it clears the database and every stored preference.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_xl"
        android:paddingBottom="@dimen/space_xxl">

        <!-- Top-level destination: reached by its tab, so there is no up to offer. -->
        <TextView
            style="@style/AmiText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/settings_title" />

        <!-- ================= YOUR ACCOUNT ================= -->
        <TextView
            style="@style/AmiSectionHeader"
            android:text="@string/profile_section_account" />

        <LinearLayout
            android:id="@+id/groupAccount"
            style="@style/AmiSettingsGroup" />

        <TextView
            android:id="@+id/accountFooter"
            style="@style/AmiText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_sm"
            android:paddingStart="@dimen/space_xs"
            android:paddingEnd="@dimen/space_xs"
            android:text="@string/profile_account_footer" />

        <!-- ================= ABOUT & HELP ================= -->
        <TextView
            style="@style/AmiSectionHeader"
            android:text="@string/profile_section_about" />

        <LinearLayout
            android:id="@+id/groupAbout"
            style="@style/AmiSettingsGroup" />

        <!--
          Destructive actions sit apart from the list, with a gap above them, so that
          reaching one takes a separate deliberate movement rather than one more scroll.
        -->
        <LinearLayout
            android:id="@+id/groupDanger"
            style="@style/AmiSettingsGroup"
            android:layout_marginTop="@dimen/space_xl" />

    </LinearLayout>
</ScrollView>

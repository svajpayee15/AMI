<?xml version="1.0" encoding="utf-8"?>
<!-- Shared shell for the five "About & help" pages; content is set by InfoActivity. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_lg"
        android:paddingBottom="@dimen/space_xxl">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBack"
            style="@style/AmiButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_back"
            app:icon="@drawable/ic_chevron_left" />

        <TextView
            android:id="@+id/infoTitle"
            style="@style/AmiText.Display"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" />

        <LinearLayout
            style="@style/AmiCard"
            android:layout_marginTop="@dimen/space_lg">

            <TextView
                android:id="@+id/infoBody"
                style="@style/AmiText.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReport"
            style="@style/AmiButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg"
            android:text="@string/info_report_send"
            android:visibility="gone"
            app:icon="@drawable/ic_mail" />

    </LinearLayout>
</ScrollView>

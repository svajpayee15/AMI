<?xml version="1.0" encoding="utf-8"?>
<!--
  Onboarding / consent screen.

  The previous version was a single TextView holding a wall of bullet text, which
  is exactly what this audience skims past - and consent that isn't read isn't
  consent. Each disclosure is now its own icon + heading + sentence, so the five
  things AMI does are scannable individually. The continue button is pinned to the
  bottom bar rather than scrolling away with the content.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_gutter"
            android:paddingEnd="@dimen/screen_gutter"
            android:paddingTop="@dimen/space_xxl"
            android:paddingBottom="@dimen/space_xl">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:background="@drawable/bg_icon_circle"
                android:padding="18dp"
                android:src="@drawable/ic_shield"
                app:tint="@color/ami_on_primary_container"
                android:importantForAccessibility="no"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/onboardingTitle"
                style="@style/AmiText.Display"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/onboarding_welcome" />

            <TextView
                style="@style/AmiText.Body.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/onboarding_tagline" />

            <TextView
                style="@style/AmiText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:text="@string/onboarding_section" />

            <LinearLayout
                style="@style/AmiCard"
                android:layout_marginTop="@dimen/space_md">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="0dp"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <ImageView
                    style="@style/AmiPointIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_eye" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmiPointTitle"
                        android:text="@string/onboarding_screen_title" />

                    <TextView
                        style="@style/AmiPointBody"
                        android:text="@string/onboarding_screen_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <ImageView
                    style="@style/AmiPointIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_speaker" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmiPointTitle"
                        android:text="@string/onboarding_guide_title" />

                    <TextView
                        style="@style/AmiPointBody"
                        android:text="@string/onboarding_guide_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <ImageView
                    style="@style/AmiPointIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_pill" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmiPointTitle"
                        android:text="@string/onboarding_medicine_title" />

                    <TextView
                        style="@style/AmiPointBody"
                        android:text="@string/onboarding_medicine_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <ImageView
                    style="@style/AmiPointIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_mail" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmiPointTitle"
                        android:text="@string/onboarding_caregiver_title" />

                    <TextView
                        style="@style/AmiPointBody"
                        android:text="@string/onboarding_caregiver_body" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:orientation="horizontal"
                android:baselineAligned="false">

                <ImageView
                    style="@style/AmiPointIcon"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_lock" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/space_md"
                    android:orientation="vertical">

                    <TextView
                        style="@style/AmiPointTitle"
                        android:text="@string/onboarding_privacy_title" />

                    <TextView
                        style="@style/AmiPointBody"
                        android:text="@string/onboarding_privacy_body" />
                </LinearLayout>
            </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/AmiText.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_lg"
                android:text="@string/onboarding_footer" />

        </LinearLayout>
    </ScrollView>

    <!-- Pinned action bar: the consent button is always reachable -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/ami_surface"
        android:elevation="12dp"
        android:paddingStart="@dimen/screen_gutter"
        android:paddingEnd="@dimen/screen_gutter"
        android:paddingTop="@dimen/space_md"
        android:paddingBottom="@dimen/space_md">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnboardingContinue"
            style="@style/AmiButton"
            android:layout_height="wrap_content"
            android:text="@string/onboarding_continue"
            app:icon="@drawable/ic_check_circle" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="8dp">

    <ImageView
        android:id="@+id/ami_stop_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginEnd="8dp"
        android:background="@drawable/cursor_background"
        android:src="@drawable/ic_ami_stop"
        android:contentDescription="@string/ami_trigger_stop_description"
        android:padding="10dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ami_trigger_icon"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/cursor_background"
        android:src="@drawable/ic_ami_brain"
        android:contentDescription="@string/ami_trigger_description"
        android:padding="8dp"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>

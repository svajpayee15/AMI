<?xml version="1.0" encoding="utf-8"?>
<!--
  One caregiver in the escalation chain. The position number is not decoration: the
  order decides who is contacted first and who is only pulled in when the silence
  continues, so it has to be visible.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:baselineAligned="false"
    android:background="@drawable/bg_medicine_row"
    android:paddingStart="@dimen/space_md"
    android:paddingEnd="@dimen/space_sm"
    android:paddingTop="@dimen/space_sm"
    android:paddingBottom="@dimen/space_sm">

    <TextView
        android:id="@+id/caregiverPosition"
        style="@style/AmiText.Subtitle"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_icon_circle"
        android:gravity="center"
        android:textColor="@color/ami_on_primary_container"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_md"
        android:orientation="vertical">

        <TextView
            android:id="@+id/caregiverName"
            style="@style/AmiText.Subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/caregiverEmail"
            style="@style/AmiText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/caregiverRole"
            style="@style/AmiText.Body.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnMoveUp"
        android:layout_width="@dimen/touch_target_small"
        android:layout_height="@dimen/touch_target_small"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_chevron_left"
        android:rotation="90"
        android:scaleType="centerInside"
        android:padding="@dimen/space_md"
        app:tint="@color/ami_primary"
        android:contentDescription="@string/settings_caregiver_move_up" />

    <ImageButton
        android:id="@+id/btnRemoveCaregiver"
        android:layout_width="@dimen/touch_target_small"
        android:layout_height="@dimen/touch_target_small"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_trash"
        android:scaleType="centerInside"
        android:padding="@dimen/space_md"
        app:tint="@color/ami_danger"
        android:contentDescription="@string/settings_caregiver_remove" />

</LinearLayout>

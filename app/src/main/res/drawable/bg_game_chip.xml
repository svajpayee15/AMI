<?xml version="1.0" encoding="utf-8"?>
<!--
  Genre chip, unselected. Selected state swaps to bg_game_chip_on; kept as two drawables
  rather than a selector because the chips are toggled in code, not by view state.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/game_cream" />
    <corners android:radius="12dp" />
    <stroke android:width="2dp" android:color="#33000000" />
</shape>
